# ============================================
# LLM CONFIGURATION
# ============================================

# API Providers (provide at least one)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here

# Google Gemini (used for search_error_solution tool and as main LLM option)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  # Alternative name, same as GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp  # Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash

# GitHub Token (optional but recommended for code search)
GITHUB_TOKEN=your_github_token_here

# ============================================
# ADVANCED LLM CONFIGURATION
# ============================================

# API Model Configuration
GEMINI_MODEL=gemini-2.5-flash # For Google
LLM_MODEL=gpt-4-turbo-preview  # For OpenAI
LLM_TEMPERATURE=0.3  # Global temperature setting. Overrides code defaults if set.
GROQ_MODEL=llama-3.3-70b-versatile  # For Groq
# LLM_MAX_TOKENS=4096  # Optional: Max tokens for LLM responses

# ============================================
# ARCHITECTURE CONFIGURATION
# ============================================

# Supervisor Architecture
# Set to 'true' to enable the new cyclic, supervisor-driven architecture.
# This enables specialized agents (Planner, Supervisor, Critic) and robust error recovery.
# Set to 'false' (default) to use the legacy linear workflow (better for simple papers).
USE_SUPERVISOR_ARCHITECTURE=true

# Enable LLM-based critic for deeper action inspection
# Uses cheap model (Gemini Flash) for edge case detection
# Set to 'true' for more thorough safety checks
ENABLE_LLM_CRITIC=false

# ============================================
# LANGCHAIN TRACING (Optional)
# ============================================

# Enable LangSmith tracing for debugging
LANGCHAIN_TRACING_V2=false  # Set to true to enable
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=paper-reproduction

# ============================================
# OBSERVABILITY & COSTS
# ============================================

# Live Progress Display
# Set to 'true' to show real-time metrics (time, tokens, cost) during execution.
# Defaults to 'false' to keep output clean.
# IMPORTANT: If set to 'true', you MUST provide the cost rates below for accurate estimates.
enable_live_progress=false

# Progress Update Interval (seconds)
# How often to update the live display line.
progress_update_interval=15

# LLM Cost Configuration (per 1 Million tokens)
# Required if enable_live_progress=true.
# Current examples (Gemini 2.5 Flash): Input=0.30, Output=3.50
# Other Examples:
#   Gemini 1.5 Flash: Input=0.075, Output=0.30
#   GPT-4o:           Input=2.50, Output=10.00
#   Claude 3.5 Sonnet: Input=3.00, Output=15.00
LLM_INPUT_COST_PER_M=0.3
LLM_OUTPUT_COST_PER_M=3.5

# Embedding Cost (per 1 Million tokens)
# Used for tracking embedding API costs in metrics.
# Examples:
#   Gemini text-embedding-004: ~$0.00 (free tier) or $0.025
#   OpenAI text-embedding-3-small: $0.02
#   OpenAI ada-002: $0.10
EMBEDDING_COST_PER_M=0.10

# ============================================
# EMBEDDING CONFIGURATION (Hierarchical Context)
# ============================================

# Embedding Provider
# Controls how embeddings are generated for hierarchical context manager.
# Options:
#   "gemini" (default) - Uses Gemini API (fast, no local model, ~$0.00001/query)
#   "openai" - Uses OpenAI embeddings API
#   "local" - Uses SentenceTransformer locally (~100MB RAM, slower startup)
#   "none" - Disables embeddings (hot storage only, no semantic search)
EMBEDDING_PROVIDER=gemini

# Embedding Model
# Model name for API-based embeddings.
# Gemini: text-embedding-004 (768 dims)
# OpenAI: text-embedding-3-small (1536 dims)
# Local: all-MiniLM-L6-v2 (384 dims)
EMBEDDING_MODEL=text-embedding-004

# ============================================
# DEBUG & VERBOSE OUTPUT
# ============================================

# Show Agent Reasoning
# Set to 'true' to display each agent's reasoning/thought process during execution.
# Useful for debugging and understanding agent decisions.
# Defaults to 'false' to keep output clean.
SHOW_REASONING=false
