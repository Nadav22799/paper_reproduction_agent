# ============================================
# LLM CONFIGURATION
# ============================================

# Option 1: Local LLM (No API key needed, no rate limits!)
# Recommended for avoiding rate limits and API costs
USE_LOCAL_LLM=false  # Set to 'true' to use local model
LOCAL_LLM_BACKEND=ollama  # Options: 'ollama' or 'huggingface'
LOCAL_LLM_MODEL=gemma2:2b  # For ollama. For HF use: google/gemma-2-2b-it or google/gemma-3-270m
OLLAMA_BASE_URL=http://localhost:11434  # Default Ollama URL

# HuggingFace Token (required for gated models like Gemma, Llama, etc.)
# Get your token from: https://huggingface.co/settings/tokens
# Accept model license first at: https://huggingface.co/google/gemma-3-270m
HUGGINGFACE_TOKEN=your_hf_token_here

# Setup instructions for local LLM:
# 1. Using Ollama (Easiest, Recommended):
#    - Install Ollama: https://ollama.com/download
#    - Pull model: ollama pull gemma2:2b
#    - Set: USE_LOCAL_LLM=true, LOCAL_LLM_BACKEND=ollama
#
# 2. Using HuggingFace (Direct transformers):
#    - Install: pip install transformers torch accelerate
#    - Set: USE_LOCAL_LLM=true, LOCAL_LLM_BACKEND=huggingface
#    - First run will download model (~5GB for gemma-2-2b)
#
# 3. Using vLLM Server (Advanced):
#    - Set USE_LOCAL_LLM=false
#    - Set OPENAI_API_BASE=http://localhost:8000/v1
#    - Set LLM_MODEL to your vLLM model name

# Option 2: API Providers (provide at least one if not using local)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here

# Google Gemini (used for search_error_solution tool and as main LLM option)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  # Alternative name, same as GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp  # Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash

# GitHub Token (optional but recommended for code search)
GITHUB_TOKEN=your_github_token_here

# ============================================
# ADVANCED LLM CONFIGURATION
# ============================================

# API Model Configuration (only used if USE_LOCAL_LLM=false)
LLM_MODEL=gpt-4-turbo-preview  # For OpenAI
LLM_TEMPERATURE=0.1
GROQ_MODEL=llama-3.3-70b-versatile  # For Groq
LLM_MAX_TOKENS=4096  # Optional: Max tokens for LLM responses

# Custom OpenAI API Base (for vLLM, LM Studio, etc.)
# OPENAI_API_BASE=http://localhost:8000/v1  # Uncomment to use local vLLM server

# XML Tool Parser (for models that don't support native function calling)
USE_XML_TOOL_PARSER=false  # Set to true for models without native tool support

# Simple Environment Setup (faster, no LLM for environment setup)
USE_SIMPLE_ENV_SETUP=false  # Set to true to skip LLM-based environment setup

# ============================================
# VLLM CONFIGURATION (if using vLLM server)
# ============================================

VLLM_DEBUG=false  # Enable debug logging for vLLM
DISABLE_VLLM_WRAPPER=false  # Disable vLLM wrapper if causing issues
VLLM_ENABLE_RECOVERY=true  # Enable recovery from empty responses

# ============================================
# LANGCHAIN TRACING (Optional)
# ============================================

# Enable LangSmith tracing for debugging
LANGCHAIN_TRACING_V2=false  # Set to true to enable
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=paper-reproduction
